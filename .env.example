# ─────────────────────────────────────────────────────────────────────────────
# Claude / Anthropic
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override if using a corporate LLM gateway or regional proxy.
# ANTHROPIC_BASE_URL=https://your-internal-llm-gateway.com

# ─────────────────────────────────────────────────────────────────────────────
# Model Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Model used by both Generator and Critique agents (can be overridden individually)
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# Token budgets per agent role
GENERATOR_MAX_TOKENS=16000
CRITIQUE_MAX_TOKENS=8192
MAX_RETRIES=2

# Extended thinking — enables Claude's deep reasoning mode for the Generator.
# Requires GENERATOR_MAX_TOKENS > THINKING_BUDGET_TOKENS.
EXTENDED_THINKING=false
THINKING_BUDGET_TOKENS=10000

# ─────────────────────────────────────────────────────────────────────────────
# Orchestration
# ─────────────────────────────────────────────────────────────────────────────
# Maximum Generator↔Critique iterations before giving up and returning best draft.
MAX_ITERATIONS=3

# Inner ReAct loop safety caps — limit tool-call rounds within a single agent
# invocation (independently of the outer iteration count above).
# Increase if tasks require extensive document reading; decrease to cut cost.
GENERATOR_MAX_TOOL_CALLS=15
CRITIQUE_MAX_TOOL_CALLS=10

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL Checkpointer (optional — leave unset to use in-memory store)
# ─────────────────────────────────────────────────────────────────────────────
# Required for HITL pause/resume and crash-safe state persistence.
# Format: postgresql://user:password@host:port/dbname
# DATABASE_URL=postgresql://agent:secret@localhost:5432/critique_agent

# ─────────────────────────────────────────────────────────────────────────────
# Vector Episodic Memory (optional — disabled by default)
# ─────────────────────────────────────────────────────────────────────────────
# Stores critique episodes as 384-dim vectors in PostgreSQL using the pgvector
# extension. Requires DATABASE_URL to be set (uses the same PG instance).
# On first use, downloads the all-MiniLM-L6-v2 sentence-transformer (~90 MB).
VECTOR_MEMORY_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOCAL_DATA_DIR=local_data
