# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment secrets — never commit real credentials
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs
*.log

# Local data (user uploads — excluded from version control)
local_data/*
!local_data/.gitkeep

# uv.lock is intentionally tracked — ensures reproducible installs across environments
# (do NOT add uv.lock here)
